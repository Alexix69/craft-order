# Base de datos PostgreSQL (Docker Compose la crea automáticamente con estos valores)
DB_USERNAME=craftorder
DB_PASSWORD=craftorder2026

# Cloudinary — almacenamiento de imágenes y PDFs
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Resend — servicio de correo electrónico
# Crea una cuenta gratuita en https://resend.com y obtén tu API key
RESEND_API_KEY=tu_resend_api_key

# URL base del frontend (no modificar si usas la configuración por defecto)
APP_BASE_URL=http://localhost:8081
